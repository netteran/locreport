{
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "redirects": [
    { "source": "/admin/scraped-sources", "destination": "/admin/scraped-feeds", "permanent": true },
    { "source": "/intelligence/signals", "destination": "/intelligence", "permanent": true },
    { "source": "/intelligence/signals/:id", "destination": "/intelligence", "permanent": true },
    { "source": "/intelligence/high-impact", "destination": "/intelligence", "permanent": true },
    { "source": "/intelligence/correlations", "destination": "/intelligence", "permanent": true },
    { "source": "/intelligence/correlations/", "destination": "/intelligence", "permanent": true },
    { "source": "/dashboard", "destination": "/", "permanent": true },
    { "source": "/dashboard/", "destination": "/", "permanent": true },
    { "source": "/login/", "destination": "/login", "permanent": true },
    { "source": "/cdn-cgi/l/email-protection", "destination": "/", "permanent": true },
    { "source": "/support", "destination": "/contact", "permanent": true },
    { "source": "/support/", "destination": "/contact", "permanent": true },
    { "source": "/404.html", "destination": "/", "permanent": true },
    { "source": "/newsletter", "destination": "/", "permanent": true },
    { "source": "/newsletter/:path*", "destination": "/", "permanent": true },
    { "source": "/thank-you", "destination": "/", "permanent": true },
    { "source": "/thank-you/", "destination": "/", "permanent": true }
  ]
}
